# ===== Backend =====
APP_ENV=development
DATABASE_URL=sqlite:///./smart_posture.db
CORS_ORIGINS=http://localhost:5173

# ===== MQTT =====
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=spc

# ===== Perangkat =====
# Kunci untuk header X-Device-Key (ganti di lingkungan nyata)
DEVICE_API_KEY=change-me
HEARTBEAT_TIMEOUT_S=30

# ===== Frame / Pose =====
MAX_FRAME_BYTES=512000
MAX_FPS_PER_DEVICE=3
# JANGAN aktifkan di penggunaan normal (privasi). Hanya untuk debugging terkontrol.
DEBUG_SAVE_FRAMES=false

# ===== Parameter postur (nilai awal, perlu validasi pengujian) =====
VIEW_MODE=side
MIN_VISIBILITY=0.5
WARNING_MIN_FRAMES=5
TOLERANCE_SECONDS=7
RECOVERY_FRAMES=3
REMIND_INTERVAL_S=60
CAPTURE_FPS=1

# ===== PWA (Vite) =====
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
